# Clé API Anthropic : remplacer la valeur ci-dessous par votre clé.
ANTHROPIC_API_KEY=mettre-votre-cle-api-ici

# Nom du modèle utilisé par les TP.
MODELE=claude-haiku-5-5

# Langfuse local, pour les TP 10 à 12. À décommenter quand votre Langfuse tourne.
# Ce sont les clés que crée le fichier langfuse.env, à côté de celui-ci : elles ne valent que sur votre machine.
# LANGFUSE_PUBLIC_KEY=pk-lf-formation
# LANGFUSE_SECRET_KEY=sk-lf-formation
# LANGFUSE_BASE_URL=http://localhost:3000
