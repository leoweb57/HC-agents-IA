# Réglages du Langfuse local de la formation. À donner à Docker Compose : voir le README du TP 10.
# Au premier démarrage, Langfuse crée l'organisation, le projet, ses deux clés et le compte ci-dessous.
# Ces valeurs ne servent que sur votre machine. Pas de guillemets autour des valeurs.
LANGFUSE_INIT_ORG_ID=formation
LANGFUSE_INIT_ORG_NAME=Formation Agents IA
LANGFUSE_INIT_PROJECT_ID=atelier
LANGFUSE_INIT_PROJECT_NAME=Atelier
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-formation
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-formation
LANGFUSE_INIT_USER_EMAIL=stagiaire@example.com
LANGFUSE_INIT_USER_NAME=Stagiaire
LANGFUSE_INIT_USER_PASSWORD=formation-agents-ia
